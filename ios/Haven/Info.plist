<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Partial plist: everything else is generated from build settings
	  (GENERATE_INFOPLIST_FILE merges this file in). This exists for the keys
	  that have no INFOPLIST_KEY_* build-setting form: the launch screen's
	  background colour, the url scheme, and the export-compliance answer.
	  The launch colour points at the LaunchBackground colour set, which is
	  HavenColor.night, so launch paints the exact colour the first frame
	  starts on and the handoff is invisible.
	-->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<!--
	  The scheme the Lock Screen widget opens. Declared here or iOS has no
	  reason to route haven:// to this app, and the widget's tap does nothing
	  at all. The one url behind it is defined in HavenDeepLink, which both
	  the app and the widget target compile.
	-->
	<!--
	  Asked for at the moment somebody points the phone at a card, and never
	  before: DataScannerViewController requests it when scanning starts, and
	  the connect screen only starts scanning when it is open. The wording says
	  what the camera is for and what it is not -- no frame is stored, uploaded
	  or read for anything but the code.
	-->
	<key>NSCameraUsageDescription</key>
	<string>Haven uses the camera to read the code on the back of somebody's card. Nothing it sees is saved or sent anywhere.</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.inhavens.haven</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>haven</string>
			</array>
		</dict>
	</array>
	<!--
	  The export-compliance answer, given once here instead of by hand on every
	  upload. False is the truthful answer, not a shortcut: the only encryption
	  Haven uses is HTTPS to Convex and Clerk, which is exempt under category 5
	  part 2.

	  Revisit this if Haven ever ships its own cryptography, which is a real
	  possibility the day connect tokens or end-to-end shared notes land.
	-->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>

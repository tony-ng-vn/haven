<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!--
  Apple's privacy manifest. Two jobs: it declares a reason for every
  required-reason API the app calls, which is a hard upload check, and it feeds
  the privacy report that has to match the App Privacy answers in App Store
  Connect. Keep this file and those answers in step, and keep both in step with
  the policy at inhavens.com/privacy.

  Note: of Haven's dependencies only PhoneNumberKit ships a manifest of its
  own. Clerk, convex-swift, and clerk-convex-swift do not. That is theirs to
  fix, not ours, but it is why an upload may warn about an SDK we do not own.
-->
<dict>
	<!-- Nothing here follows anyone across other companies' apps or sites. -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>

	<!--
	  Everything below is linked to the person, because Haven is an account:
	  the whole product is your card and your directory, so none of it is
	  anonymous. None of it is used for tracking, and the only purpose is the
	  app working at all.
	-->
	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<!-- The name on your card, and the names of people you save. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeName</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<!-- From the sign-in, including an Apple private relay address. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeEmailAddress</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<!-- Phone is one of the four handle types a card can carry. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypePhoneNumber</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<!-- The card photo, and photos attached to saved people. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypePhotosorVideos</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<!-- Clerk's user id, which is what owns every row. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeUserID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<!--
		  The rest of the card and the directory: city, company, role, social
		  handles, and the notes you write about people. Apple has no category
		  for "a private note about someone you met", and this is the closest
		  honest one.
		-->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeOtherUserContentData</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
	</array>

	<!--
	  The camera is deliberately absent from both lists above and below, and
	  that is the answer rather than an omission. It is not a required-reason
	  API, so it declares nothing here; it is asked for with
	  NSCameraUsageDescription in Info.plist instead. And nothing it sees is
	  collected: the connect scanner reads one code out of the frames and keeps
	  none of them, so there is no photo or video data type to declare. What the
	  code turns into -- a connection to somebody who is already a Haven user --
	  is the contact information already declared above.
	-->
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<!--
		  UserDefaults, for two per-user flags that never leave the device: which
		  onboarding steps someone finished (OnboardingModel) and whether the
		  widget promo has been dismissed (DirectoryModel). CA92.1 is the
		  "this app's own data only" reason, which is exactly what those are.
		-->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>

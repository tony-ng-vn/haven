<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Clerk's signInWithApple() is native ASAuthorization, not a web sheet, and
	  ASAuthorizationAppleIDProvider needs this entitlement to answer at all.
	  The simulator does not enforce it, so the welcome screen's primary button
	  works in development and fails on a real device with error 1000, which
	  reads as "Apple is down" rather than "the entitlement is missing".

	  Needs the matching Sign In with Apple capability on the App ID in the
	  developer portal; the entitlement alone does not provision.
	-->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<!--
	  What makes a tap on inhavens.com/<handle> open Haven instead of Safari.
	  iOS fetches https://inhavens.com/.well-known/apple-app-site-association on
	  install and honours whatever that file claims; the file lives in `public/`
	  and a test keeps it from claiming the site's own pages.

	  Needs the Associated Domains capability on the App ID in the developer
	  portal, and the file needs the real Team ID in place of its placeholder.
	  Neither is something a commit can do, and until both are done a scanned
	  code still lands in Safari -- which is what it does today, so nothing
	  regresses while they are outstanding.
	-->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:inhavens.com</string>
	</array>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.inhavens.haven</string>
	</array>
	<!--
	  The container the share extension writes captures into. The extension
	  carries the identical entitlement; a group only one of them holds is not
	  shared, and each process quietly gets its own private directory instead
	  of an error.

	  Needs the group registered in the developer portal and added to both App
	  IDs, the same way the Sign In with Apple capability above does. The
	  simulator does not enforce it, so a missing registration shows up only on
	  a real device -- as captures that vanish.
	-->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.inhavens.haven</string>
	</array>
</dict>
</plist>

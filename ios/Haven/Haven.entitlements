<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Universal links (a tap on inhavens.com/<handle> opening Haven instead of
	  Safari) are DEFERRED, and their associated-domains entitlement is
	  deliberately absent: the free personal team the project signs with does
	  not support that capability, and Xcode's automatic signing refuses to
	  build an app that declares it. The links were never functional anyway --
	  the apple-app-site-association file in `public/` still carries a
	  placeholder Team ID, so a scanned code lands in Safari today either way.
	  Re-add `com.apple.developer.associated-domains` with
	  `applinks:inhavens.com` in the same commit that joins the paid developer
	  program and puts the real Team ID in that file.
	-->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.inhavens.haven</string>
	</array>
	<!--
	  The container the share extension writes captures into. The extension
	  carries the identical entitlement; a group only one of them holds is not
	  shared, and each process quietly gets its own private directory instead
	  of an error.

	  Needs the group registered in the developer portal and added to both App
	  IDs. The simulator does not enforce it, so a missing registration shows
	  up only on a real device -- as captures that vanish.
	-->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.inhavens.haven</string>
	</array>
</dict>
</plist>

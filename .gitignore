# Worktrees symlink node_modules back to the root install, and a trailing
# slash matches only real directories, so the symlink showed as untracked.
node_modules
dist/
.env.local
.env
.friendy/
.euno/
.haven/
*.tsbuildinfo
.DS_Store

# tool artifact
# Not .entire/ wholesale: git never looks inside an ignored directory, so that
# also hid .entire/settings.json, the one file Entire expects committed. Its own
# .entire/.gitignore already excludes the noise (tmp/, metadata/, logs/).
.vercel
.impeccable/live/sessions/
.worktrees/
pr-walkthrough/
tsconfig.tsbuildinfo
